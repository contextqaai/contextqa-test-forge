# ContextQA is the default automation layer. Real values belong only in an
# ignored owner-readable .env or secret manager, never this tracked example.
# Node does not auto-load .env: node --env-file=.env scripts/COMMAND.js ...
CONTEXTQA_API_TOKEN=

# Optional AI drafting: choose openai, anthropic, or openai-compatible.
AI_PROVIDER=
AI_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AI_MAX_OUTPUT_TOKENS=2048

# Compatible Chat Completions only. Leave blank for native providers.
# AI_API_KEY takes precedence over provider-specific keys in this adapter.
AI_API_KEY=
AI_BASE_URL=
AI_ALLOW_CUSTOM_HOST=

# Only the selected source needs credentials. JSON import needs none.
GITHUB_TOKEN=
# Optional subscription watch credential; each GitHub watch must explicitly set
# tokenEnv: "GITHUB_SOURCE_TOKEN". Read Issues only on selected source repos.
GITHUB_SOURCE_TOKEN=
# Separate opt-in private-repo PR publication credential. Selected destination
# repository only: Contents write + Pull requests write. Never ordinary test CI.
GITHUB_SYNC_TOKEN=
LINEAR_API_KEY=
JIRA_EMAIL=
JIRA_API_TOKEN=
TESTRAIL_EMAIL=
TESTRAIL_API_KEY=
XRAY_BEARER_TOKEN=
