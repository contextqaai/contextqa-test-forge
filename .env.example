# Optional AI. Load using node --env-file=.env scripts/ai-draft.js ...
AI_PROVIDER=openai
AI_MODEL=
OPENAI_API_KEY=
# For Claude: AI_PROVIDER=anthropic; ANTHROPIC_API_KEY=...
# Compatible: AI_PROVIDER=openai-compatible; AI_API_KEY=...
# AI_BASE_URL=https://your-provider.example/v1/
# AI_ALLOW_CUSTOM_HOST=your-provider.example
AI_MAX_OUTPUT_TOKENS=2048
